# ==============================================================================
# Lenny Growth Assistant - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables to match your runtime environment:
#   cp .env.example .env
# ==============================================================================

# ─── 1. Application Runtime ───────────────────────────────────────────────────
# APP_ENV: "development" for colored console logs; "production" for JSON structured logs
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME="Lenny Growth Assistant"
APP_VERSION="1.0.0"

# FRONTEND_ORIGIN: Allowed CORS origin for the React client
# In local development: http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# ─── 2. PostgreSQL & pgvector Database ────────────────────────────────────────
# DATABASE_URL: Async SQLAlchemy connection string (requires postgresql+asyncpg://)
#
# A) Native Host Setup (macOS Homebrew PostgreSQL):
#    postgresql+asyncpg://<username>:<password>@localhost:5432/lenny_growth
#    Example without password: postgresql+asyncpg://apple:@localhost:5432/lenny_growth
#
# B) Docker Compose Setup (services communicate across docker network):
#    postgresql+asyncpg://postgres:postgres@postgres:5432/lenny_growth
#
# C) Native Host connecting to Docker Compose PostgreSQL container:
#    postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
DATABASE_URL=postgresql+asyncpg://apple:@localhost:5432/lenny_growth

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2

# ─── 3. Local LLM & Embeddings (Ollama on Host) ───────────────────────────────
# OLLAMA_BASE_URL:
#   - Native Host: http://localhost:11434
#   - Inside Docker Compose: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Models:
#   - Generation: llama3.2:3b (optimized for 8 GB Intel Mac CPU execution)
#   - Embedding: nomic-embed-text (768-dimensional dense vector embeddings)
OLLAMA_GENERATION_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# On CPU-constrained Intel Macs, 60-90s prevents 504 timeouts during long generations
OLLAMA_TIMEOUT_SECONDS=90.0

# ─── 4. Model Provider & Cloud Fallback ────────────────────────────────────────
# ACTIVE_LLM_PROVIDER: "local_ollama" (default local-first) or "cloud"
ACTIVE_LLM_PROVIDER=local_ollama

# Privacy Guardrail: Cloud provider is NEVER contacted unless ACTIVE_LLM_PROVIDER
# is set to "cloud" or explicitly selected in the UI. If keys are missing, an
# explicit 401 AuthenticationError is raised without silently leaking prompts.
CLOUD_PROVIDER_TYPE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── 5. RAG & Retrieval Thresholds ───────────────────────────────────────────
# Cosine similarity minimum threshold (0.0 to 1.0). Passages below this score
# trigger the Insufficient Evidence guardrail to prevent AI hallucinations.
SIMILARITY_THRESHOLD=0.65

# Maximum top passages retrieved per user query turn
TOP_K_CHUNKS=4

# Chunking hyperparameters for transcript parser
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
