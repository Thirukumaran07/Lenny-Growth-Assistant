# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16+ with pgvector)
# Local native Homebrew PostgreSQL: postgresql+asyncpg://apple:@localhost:5432/lenny_growth
# Docker Compose default: postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
DATABASE_URL=postgresql+asyncpg://apple:@localhost:5432/lenny_growth
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60.0

# Active Model Provider: "local_ollama" or "cloud"
ACTIVE_LLM_PROVIDER=local_ollama

# Cloud LLM Provider (Optional fallback - requires API key if ACTIVE_LLM_PROVIDER=cloud)
CLOUD_PROVIDER_TYPE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# RAG & Similarity Configuration
SIMILARITY_THRESHOLD=0.65
TOP_K_CHUNKS=4
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
